    {
      "id": "nzaNhbTx9gaAqXuqrcZ0S",
      "type": "text",
      "x": 323,
      "y": 1816.5,
      "width": 292.01666259765625,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
