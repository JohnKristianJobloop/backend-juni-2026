    {
      "id": "rtFT6yTdLybGR0dAf7pDL",
      "type": "text",
      "x": 310,
      "y": 2743.5,
      "width": 1466.050048828125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3A",
      "roundness": null,
      "seed": 232019202,
      "version": 327,
      "versionNonce": 1554848578,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780402955853,
      "link": null,
      "locked": false,
      "text": "Dette representerer det kunden gir oss når vi starter en ny reparasjons ordre. Vi henter kun den informasjonen vi kan realistisk hente fra kunden vår. \nDet kan være opp til parseren og legge inn ekstra informasjon. \n\nVi kan nå se for oss hvordan et objekt vil se ut etter parseren vår er ferdig med sin jobb. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dette representerer det kunden gir oss når vi starter en ny reparasjons ordre. Vi henter kun den informasjonen vi kan realistisk hente fra kunden vår. \nDet kan være opp til parseren og legge inn ekstra informasjon. \n\nVi kan nå se for oss hvordan et objekt vil se ut etter parseren vår er ferdig med sin jobb. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
